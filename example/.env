# Normal configuration, bundled as a plain asset (never put secrets here).
# Values can be overridden by .env.<environment>, PLAYX_DEFINES and dartDefines.
APP_NAME=Playx Core
HOST=dev.example.com
API_URL=https://$HOST/api
ENABLE_LOGS=true
THEME_MODE=light
TIMEOUT=30s
SUPPORTED_LOCALES=en, ar
FEATURES={"newCheckout": false, "maxUploads": 3}
