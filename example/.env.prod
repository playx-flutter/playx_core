# Loaded after .env with `--dart-define=PLAYX_ENV=prod` or `--flavor prod`.
APP_NAME=Playx Core
HOST=api.example.com
# $VAR is resolved when a line is read, so values built from HOST in .env
# keep the old host: redefine them here.
API_URL=https://$HOST/api
ENABLE_LOGS=false
TIMEOUT=10s
FEATURES={"newCheckout": true, "maxUploads": 10}
